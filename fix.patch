           echo "✓ Rule count OK ($COUNT)"
 
   lint:
     runs-on: ubuntu-latest
@@
   build:
     needs: [test, lint]
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
       - name: Verify Docker build
         run: |
           if [ -f Dockerfile ]; then
             docker build -t nlc-platform . || echo "Docker build skipped (no Dockerfile)"
           fi
       - name: Verify migrations
         run: |
           python3 -c "
           import ast, os
           for f in sorted(os.listdir('alembic/versions')):
               if f.endswith('.py'):
                   with open(f'alembic/versions/{f}') as fh:
                       ast.parse(fh.read())
           print('✓ All migrations are valid Python')
           "
